{
  "name": "@corpdk/codegen-cli",
  "version": "2026.10.0-alpha.3",
  "description": "GraphQL Code Generator plugin for resolver types and TypedDocumentNode SDK output",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CorpDK/coding-templates.git",
    "directory": "libraries/codegen-cli"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@graphql-codegen/plugin-helpers": "^6.2.0",
    "graphql": "^16.13.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
