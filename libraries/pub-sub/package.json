{
  "name": "@corpdk/pub-sub",
  "version": "2026.10.0-alpha.13",
  "description": "Plugin-style GraphQL pub/sub factory (in-memory or Redis)",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CorpDK/coding-templates.git",
    "directory": "libraries/pub-sub"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@graphql-yoga/redis-event-target": "^3.0.0",
    "graphql-yoga": "^5.18.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
