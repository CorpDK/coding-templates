{
  "name": "@corpdk/dal-codegen",
  "version": "2026.10.0-alpha.9",
  "description": "Codegen CLI: Drizzle schema to GraphQL SDL, repositories, and resolvers",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CorpDK/coding-templates.git",
    "directory": "libraries/dal-codegen"
  },
  "bin": {
    "dal-codegen": "./dist/cli.js",
    "dal-entity-lint": "./dist/lint-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@corpdk/dal-core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.13.2",
    "tsx": "^4.21.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}
