  },
  "peerDependencies": {
    "graphql-scalars": "^1.26.0",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "graphql-scalars": { "optional": true },
    "zod": { "optional": true }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
