{
  "name": "@corpdk/graphql-dsl",
  "version": "2026.10.0-alpha.16",
  "description": "Typed GraphQL selection DSL (owned genql fork)",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorpDK/coding-templates.git",
    "directory": "libraries/graphql-dsl"
  },
  "files": [
    "dist",
    "README.md",
    "UPSTREAM.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0"
  },
  "peerDependencies": {
    "graphql": "^16 || ^17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.2",
    "graphql": "^16.13.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
