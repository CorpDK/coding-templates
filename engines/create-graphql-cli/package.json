{
  "name": "@corpdk/create-graphql-cli",
  "version": "0.0.0-bootstrap.0",
  "description": "Scaffold and upgrade graphql-cli packages",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorpDK/coding-templates.git",
    "directory": "engines/create-graphql-cli"
  },
  "files": ["dist", "canonical", "README.md"],
  "types": "./dist/types-entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types-entry.d.ts",
      "import": "./dist/types-entry.js"
    }
  },
  "bin": { "create-graphql-cli": "./dist/index.js" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2"
  },
  "engines": { "node": ">=24.0.0" }
}
