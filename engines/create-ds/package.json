{
  "name": "@corpdk/create-ds",
  "version": "2026.10.0-alpha.14",
  "description": "Scaffold and upgrade DAL-automated GraphQL data services",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CorpDK/coding-templates.git",
    "directory": "engines/create-ds"
  },
  "files": [
    "dist",
    "starter",
    "canonical",
    "README.md"
  ],
  "types": "./dist/types-entry.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types-entry.d.ts",
      "import": "./dist/types-entry.js"
    }
  },
  "bin": {
    "create-ds": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check:canonical": "node ./dist/scripts/check-canonical.js",
    "dev": "tsc --watch --preserveWatchOutput",
    "prepack": "pnpm run build && node ./dist/scripts/sync-canonical.js",
    "sync:canonical": "pnpm run build && node ./dist/scripts/sync-canonical.js",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@corpdk/engine-kit": "workspace:^",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  }
}