DS_PORT=
# GraphQL HTTP endpoint (queries, mutations, and subscriptions over SSE on the same URL).
# Example: http://localhost:4000/graphql
# Subscriptions: send the operation with header Accept: text/event-stream (POST JSON body or GET ?query=...).
# Matches templates/ds/docker-compose.yml (host port 5433 avoids conflict with local Postgres on 5432)
DATABASE_URL=postgresql://user:pass@localhost:5433/corpdk_ds
# Optional HMAC-SHA256 signing for pagination cursors (§13). When unset, cursors are unsigned (local dev).
# DAL_CURSOR_SECRET=
# REDIS_URL=redis://localhost:6379   # uncomment to switch pubsub to Redis/Valkey
# OpenTelemetry (optional — omit for local dev without tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# DS_OTEL_ENABLED=true
# OTEL_SERVICE_NAME=@corpdk/ds
