{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dal:codegen": {
      "dependsOn": ["@corpdk/dal-codegen#build", "@corpdk/dal-core#build"],
      "inputs": ["src/db/schema/**", "dal/dal.config.yaml"],
      "outputs": ["src/generated/dal/**"],
      "cache": true
    },
    "codegen": {
      "dependsOn": ["@corpdk/codegen-cli#build", "dal:codegen"],
      "inputs": ["src/**/*.ts", "prisma/schema.prisma", "src/db/schema/**", "src/generated/dal/generated-schema.ts"],
      "outputs": ["../ds-sdk/src/generated/**", "../ds-cli/src/generated/**"],
      "cache": true
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/prisma/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "dal:codegen"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": { "outputs": [] },
    "clean": { "cache": false }
  }
}
